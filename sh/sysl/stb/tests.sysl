private fixture_hdr() -> [127]u8 =
    [
        35, 63, 82, 65, 68, 73, 65, 78, 67, 69, 10, 71, 65, 77, 77, 65, 61, 49, 10, 80,
        82, 73, 77, 65, 82, 73, 69, 83, 61, 48, 32, 48, 32, 48, 32, 48, 32, 48, 32, 48,
        32, 48, 32, 48, 10, 70, 79, 82, 77, 65, 84, 61, 51, 50, 45, 98, 105, 116, 95, 114,
        108, 101, 95, 114, 103, 98, 101, 10, 10, 45, 89, 32, 51, 32, 43, 88, 32, 52, 10, 128,
